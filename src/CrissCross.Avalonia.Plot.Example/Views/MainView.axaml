<UserControl
  x:Class="CrissCross.Avalonia.Plot.Example.Views.MainView"
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:local="clr-namespace:CrissCross.Avalonia.Plot.Example.Views"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:plot="using:CrissCross.Avalonia.Plot"
  xmlns:viewmodels="clr-namespace:CrissCross.Avalonia.Plot.Example.ViewModels"
  x:CompileBindings="False"
  d:DesignHeight="450"
  d:DesignWidth="800"
  mc:Ignorable="d"
>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition />
    </Grid.RowDefinitions>
    <WrapPanel Margin="8" HorizontalAlignment="Left" VerticalAlignment="Center">
      <TextBlock x:Name="ActiveScenarioText" Margin="0,0,12,0" VerticalAlignment="Center" FontWeight="SemiBold" />
      <Button x:Name="ShowAllChartTypesButton" Margin="0,0,6,0" Content="All chart types" />
      <Button x:Name="ShowLiveButton" Margin="0,0,6,0" Content="Live streams" />
      <Button x:Name="ShowHistoricButton" Margin="0,0,6,0" Content="Historic DateTime" />
      <Button x:Name="ShowIndicatorsButton" Margin="0,0,6,0" Content="Indicators" />
      <Button x:Name="ToggleThemeButton" Margin="0,0,12,0" />
      <CheckBox
        x:Name="CheckBoxUseFixedNumberOfPoints"
        VerticalAlignment="Center"
        Content="Use Fixed Number Of Points"
      />
      <NumericUpDown x:Name="NumberPointsPlotted" Width="200" Minimum="1" Increment="1" FormatString="0" />
    </WrapPanel>
    <plot:LiveChart x:Name="Chart" Grid.Row="1" />
  </Grid>
</UserControl>
