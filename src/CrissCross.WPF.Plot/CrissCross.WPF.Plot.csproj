<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>$(CrissCrossWpfPlotTargetFrameworks)</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <GenerateLibraryLayout>true</GenerateLibraryLayout>
    <Authors>Chris Pulman; Adriana Segher</Authors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ReactiveUI.SourceGenerators" PrivateAssets="all" />
    <PackageReference Include="ReactiveUI.Binding.Wpf" />
    <PackageReference Include="ReactiveList" />
    <PackageReference Include="ReactiveUI.Primitives.ObservableEvents" PrivateAssets="all" />
    <PackageReference Include="OpenTK" />
    <PackageReference Include="OpenTK.GLWpfControl" />
    <PackageReference Include="SkiaSharp.Views.WPF" />
  </ItemGroup>

  <ItemGroup Condition="$(TargetFramework.StartsWith('net4'))">
    <PackageReference Include="Polyfill">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <Using Include="CrissCross.Plot" />
    <Using Include="CrissCross.Plot.Interactivity" Alias="Interactivity" />
    <ProjectReference Include="..\CrissCross.Plot.Core\CrissCross.Plot.Core.csproj" />
    <ProjectReference Include="..\CrissCross.WPF.UI\CrissCross.WPF.UI.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Images\*.png" />
  </ItemGroup>
  <Import Project="..\CrissCross.Plot.Shared\CrissCross.Plot.Shared.projitems" Label="Shared" />
</Project>
