<?xml version="1.0" encoding="utf-8"?>
<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
    <AvaloniaVersion>12.1.6</AvaloniaVersion>
    <ReactiveUIVersion>28.0.0</ReactiveUIVersion>
    <ReactiveUIBindingVersion>12.1.0</ReactiveUIBindingVersion>
    <ReactiveUIPrimitivesVersion>10.2.3</ReactiveUIPrimitivesVersion>
    <DotNet10Version>10.0.15</DotNet10Version>
    <DotNet11Version>11.0.0</DotNet11Version>
    <ExtensionsHostingVersion>7.0.1</ExtensionsHostingVersion>
    <ReactiveListVersion>6.0.0</ReactiveListVersion>
    <RoslynAnalyzers>5.2.0</RoslynAnalyzers>
  </PropertyGroup>

  <ItemGroup>
    <!-- Schema validation for native Word document tests only. -->
    <PackageVersion Include="DocumentFormat.OpenXml" Version="3.5.1" />
    <!-- Avalonia Packages -->
    <PackageVersion Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3" />
    <PackageVersion Include="Avalonia" Version="$(AvaloniaVersion)" />
    <PackageVersion Include="Avalonia.Android" Version="$(AvaloniaVersion)" />
    <PackageVersion Include="Avalonia.Browser" Version="$(AvaloniaVersion)" />
    <PackageVersion Include="Avalonia.Desktop" Version="$(AvaloniaVersion)" />
    <PackageVersion Include="Avalonia.Headless" Version="$(AvaloniaVersion)" />
    <PackageVersion Include="Avalonia.Fonts.Inter" Version="$(AvaloniaVersion)" />
    <PackageVersion Include="Avalonia.iOS" Version="$(AvaloniaVersion)" />
    <PackageVersion Include="Avalonia.Skia" Version="$(AvaloniaVersion)" />
    <PackageVersion Include="Avalonia.Themes.Fluent" Version="$(AvaloniaVersion)" />

    <!-- ReactiveUI Packages -->
    <PackageVersion Include="ReactiveUI" Version="$(ReactiveUIVersion)" />
    <PackageVersion Include="ReactiveUI.Core" Version="$(ReactiveUIVersion)" />
    <PackageVersion Include="ReactiveUI.Reactive" Version="$(ReactiveUIVersion)" />
    <PackageVersion Include="ReactiveUI.Avalonia" Version="12.1.9" />
    <PackageVersion Include="ReactiveUI.Avalonia.Reactive" Version="12.1.9" />
    <PackageVersion Include="ReactiveUI.Maui" Version="$(ReactiveUIVersion)" />
    <PackageVersion Include="ReactiveUI.Maui.Reactive" Version="$(ReactiveUIVersion)" />
    <PackageVersion Include="ReactiveUI.WinForms" Version="$(ReactiveUIVersion)" />
    <PackageVersion Include="ReactiveUI.WinForms.Reactive" Version="$(ReactiveUIVersion)" />
    <PackageVersion Include="ReactiveUI.WPF" Version="$(ReactiveUIVersion)" />
    <PackageVersion Include="ReactiveUI.WPF.Reactive" Version="$(ReactiveUIVersion)" />
    <PackageVersion Include="ReactiveUI.Binding" Version="$(ReactiveUIBindingVersion)" />
    <PackageVersion Include="ReactiveUI.Binding.Reactive" Version="$(ReactiveUIBindingVersion)" />
    <PackageVersion Include="ReactiveUI.Binding.Wpf" Version="$(ReactiveUIBindingVersion)" />
    <PackageVersion Include="ReactiveUI.Binding.Wpf.Reactive" Version="$(ReactiveUIBindingVersion)" />
    <PackageVersion Include="ReactiveUI.Disposables" Version="$(ReactiveUIPrimitivesVersion)" />
    <PackageVersion Include="ReactiveUI.Primitives" Version="$(ReactiveUIPrimitivesVersion)" />
    <PackageVersion Include="ReactiveUI.Primitives.Core" Version="$(ReactiveUIPrimitivesVersion)" />
    <PackageVersion Include="ReactiveUI.Primitives.Reactive" Version="$(ReactiveUIPrimitivesVersion)" />
    <PackageVersion Include="ReactiveUI.Primitives.Async.Reactive" Version="$(ReactiveUIPrimitivesVersion)" />
    <PackageVersion Include="ReactiveUI.Primitives.Wpf" Version="$(ReactiveUIPrimitivesVersion)" />
    <PackageVersion Include="ReactiveUI.Primitives.WinForms" Version="$(ReactiveUIPrimitivesVersion)" />
    <PackageVersion Include="ReactiveUI.Primitives.Maui" Version="$(ReactiveUIPrimitivesVersion)" />
    <PackageVersion Include="ReactiveUI.Primitives.Maui.Reactive" Version="$(ReactiveUIPrimitivesVersion)" />
    <PackageVersion Include="ReactiveUI.Primitives.ObservableEvents" Version="$(ReactiveUIPrimitivesVersion)" />

    <!-- Microsoft Packages -->
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="$(DotNet11Version)" Condition="$(TargetFramework.StartsWith('net11'))" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="$(DotNet10Version)" Condition="!$(TargetFramework.StartsWith('net11'))" />
    <PackageVersion Include="Microsoft.Extensions.Logging" Version="$(DotNet11Version)" Condition="$(TargetFramework.StartsWith('net11'))" />
    <PackageVersion Include="Microsoft.Extensions.Logging" Version="$(DotNet10Version)" Condition="!$(TargetFramework.StartsWith('net11'))" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Debug" Version="$(DotNet11Version)" Condition="$(TargetFramework.StartsWith('net11'))" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Debug" Version="$(DotNet10Version)" Condition="!$(TargetFramework.StartsWith('net11'))" />
    <PackageVersion Include="Microsoft.Maui.Controls" Version="11.0.10" Condition="$(TargetFramework.StartsWith('net11'))" />
    <PackageVersion Include="Microsoft.Maui.Controls" Version="10.0.130" Condition="$(TargetFramework.StartsWith('net10'))" />
    <!-- Compatibility has no .NET 11 stable release; ScottPlot.Maui still requires the last published preview. -->
    <PackageVersion Include="Microsoft.Maui.Controls.Compatibility" Version="11.0.0-preview.5.26304.4" Condition="$(TargetFramework.StartsWith('net11'))" />
    <PackageVersion Include="Microsoft.Maui.Controls.Compatibility" Version="10.0.130" Condition="$(TargetFramework.StartsWith('net10'))" />
    <PackageVersion Include="Microsoft.Web.WebView2" Version="1.0.4370.26" />
    <PackageVersion Include="Microsoft.Xaml.Behaviors.Wpf" Version="1.1.161" />
    <PackageVersion Include="System.Drawing.Common" Version="$(DotNet11Version)" Condition="$(TargetFramework.StartsWith('net11'))" />
    <PackageVersion Include="System.Drawing.Common" Version="$(DotNet10Version)" Condition="!$(TargetFramework.StartsWith('net11'))" />
    <PackageVersion Include="Microsoft.Bcl.Memory" Version="$(DotNet10Version)" />
    <PackageVersion Include="System.Buffers" Version="4.6.1" />
    <PackageVersion Include="System.Memory" Version="4.6.3" />
    <PackageVersion Include="System.Runtime.CompilerServices.Unsafe" Version="6.1.2" />

    <!-- Source Generators (PrivateAssets) -->
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="5.12.0" />
    <PackageVersion Include="ReactiveUI.SourceGenerators" Version="7.1.0" />

    <!-- Other UI/Framework Packages -->
    <PackageVersion Include="AngleSharp" Version="1.10.5" />
    <PackageVersion Include="CP.Extensions.Hosting.ReactiveUI.Wpf" Version="$(ExtensionsHostingVersion)" />
    <PackageVersion Include="CP.Extensions.Hosting.ReactiveUI.Avalonia" Version="$(ExtensionsHostingVersion)" />
    <PackageVersion Include="CP.Extensions.Hosting.ReactiveUI.Maui" Version="$(ExtensionsHostingVersion)" />
    <PackageVersion Include="CP.Extensions.Hosting.ReactiveUI.WinForms" Version="$(ExtensionsHostingVersion)" />
    <PackageVersion Include="CP.Extensions.Hosting.Wpf" Version="$(ExtensionsHostingVersion)" />
    <PackageVersion Include="CP.Extensions.Hosting.Avalonia" Version="$(ExtensionsHostingVersion)" />
    <PackageVersion Include="CP.Extensions.Hosting.MainUIThread" Version="$(ExtensionsHostingVersion)" />
    <PackageVersion Include="CP.Xaml.Converters" Version="2.0.0" />
    <PackageVersion Include="Markdig" Version="1.6.0" />
    <PackageVersion Include="ReactiveList" Version="$(ReactiveListVersion)" />
    <PackageVersion Include="ReactiveList.Reactive" Version="$(ReactiveListVersion)" />
    <PackageVersion Include="ScottPlot.WPF" Version="5.1.59" />
    <PackageVersion Include="ScottPlot.Avalonia" Version="5.1.59" />
    <PackageVersion Include="ScottPlot.Maui" Version="5.1.59" />

    <!-- Polyfill for .NET Framework -->
    <PackageVersion Include="Polyfill" Version="12.0.0" Condition="$(TargetFramework.StartsWith('net4'))" />

    <!-- Testing Packages -->
    <PackageVersion Include="TUnit" Version="1.87.12" Condition="$(IsTestProject)" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.12.0" Condition="$(IsTestProject)" />
    <PackageVersion Include="Microsoft.Testing.Extensions.CodeCoverage" Version="18.12.0" Condition="$(IsTestProject)" />
    <PackageVersion Include="PublicApiGenerator" Version="11.5.4" Condition="$(IsTestProject)" />
    <PackageVersion Include="Microsoft.SourceLink.GitHub" Version="11.0.100" Condition="!$(IsTestProject)" />

    <PackageVersion Include="MinVer" Version="8.0.0" />
    <PackageVersion Include="StyleSharp.Analyzers" Version="$(RoslynAnalyzers)" />
    <PackageVersion Include="PerformanceSharp.Analyzers" Version="$(RoslynAnalyzers)" />
    <PackageVersion Include="SecuritySharp.Analyzers" Version="$(RoslynAnalyzers)" />
    <PackageVersion Include="Roslynator.Analyzers" Version="5.0.1" />

    <!-- Benchmarking -->
    <PackageVersion Include="BenchmarkDotNet" Version="0.15.8" />

    <!-- Android Specific -->
    <PackageVersion Include="Xamarin.AndroidX.Compose.Runtime.Annotation" Version="1.12.1" />
    <PackageVersion Include="Xamarin.AndroidX.Compose.Runtime.Annotation.Android" Version="1.12.1" />
    <PackageVersion Include="Xamarin.AndroidX.Compose.Runtime.Annotation.Jvm" Version="1.12.1" />
    <PackageVersion Include="Xamarin.AndroidX.Core.SplashScreen" Version="1.2.0.3" />
    <PackageVersion Include="Xamarin.AndroidX.Lifecycle.Process" Version="2.11.0.1" />
    <PackageVersion Include="Xamarin.AndroidX.Lifecycle.ViewModelSavedState" Version="2.11.0.1" />
    <PackageVersion Include="Xamarin.AndroidX.Lifecycle.LiveData" Version="2.11.0.1" />
    <PackageVersion Include="Xamarin.AndroidX.Lifecycle.LiveData.Core" Version="2.11.0.1" />
    <PackageVersion Include="Xamarin.AndroidX.Lifecycle.LiveData.Core.Ktx" Version="2.11.0.1" />
    <PackageVersion Include="Xamarin.AndroidX.Lifecycle.Runtime.Ktx" Version="2.11.0.1" />
    <PackageVersion Include="Xamarin.AndroidX.Lifecycle.ViewModel.Ktx" Version="2.11.0.1" />
    <PackageVersion Include="Xamarin.AndroidX.SavedState.SavedState.Ktx" Version="1.5.0.1" />
    <PackageVersion Include="Xamarin.AndroidX.Collection.Ktx" Version="1.6.0.1" />
  </ItemGroup>
</Project>
