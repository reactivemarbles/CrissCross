<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="CrissCross.MAUI.Test.MainView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:CrissCross.MAUI.Test"
    x:DataType="local:MainViewModel">
    <ContentPage.Content>
        <StackLayout Orientation="Vertical">
            <Label Text="Main View" />
            <Button x:Name="GotoFirst" Command="{Binding GotoFirst}" Text="Goto First" />
            <Button x:Name="GotoControlsGallery" Command="{Binding GotoControlsGallery}" Text="Open Controls Gallery" />
            <Button x:Name="GotoMain" Command="{Binding GotoMain}" Text="Goto Back" />
        </StackLayout>
    </ContentPage.Content>
</ContentPage>
