<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="CrissCross.MAUI.Test.FirstView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:CrissCross.MAUI.Test"
    x:DataType="local:FirstViewModel">
    <ContentPage.Content>
        <StackLayout Orientation="Vertical">
            <Label Text="First View" />
            <Button x:Name="GotoMain" Command="{Binding GotoMain}" Text="Goto Main" />
            <Button x:Name="GotoFirst" Command="{Binding GotoFirst}" Text="Goto Back" />
        </StackLayout>
    </ContentPage.Content>
</ContentPage>
