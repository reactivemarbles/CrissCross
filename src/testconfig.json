{
    "platform": {
        "execution": {
            "parallel": false
        }
    },
    "extensions": [
        {
            "extensionId": "Microsoft.Testing.Extensions.CodeCoverage",
            "settings": {
                "format": "cobertura",
                "skipAutoProperties": true,
                "modulePaths": {
                    "include": [
                        "CrissCross(?:\\..*)?"
                    ],
                    "exclude": [
                        ".*Tests.*",
                        ".*TestRunner.*",
                        ".*\\.Test($|\\..*)",
                        ".*Benchmarks.*",
                        ".*Benchmark.*",
                        ".*Gallery.*",
                        ".*Example.*",
                        ".*Demo.*"
                    ]
                }
            }
        }
    ]
}
